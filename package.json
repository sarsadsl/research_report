{
  "name": "research-report",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "research:validate": "node ./scripts/research-validate.mjs",
    "research:generate": "node ./scripts/research-generate.mjs",
    "research:import": "node ./scripts/research-import.mjs",
    "research:publish": "node ./scripts/research-publish.mjs",
    "docs:check": "node ./scripts/docs-check.mjs",
    "research:check": "npm run research:validate -- vpec-2455 && npm run research:generate -- vpec-2455 --check && npm test",
    "test": "node --test scripts/research-lib.test.mjs scripts/research-import.test.mjs scripts/report-renderer.test.mjs scripts/report-exporter.test.mjs scripts/report-qc.test.mjs scripts/research-publish.test.mjs",
    "report:materialize": "node ./scripts/materialize-reports.mjs",
    "report:export": "node ./scripts/report-exporter.mjs",
    "report:qc": "node ./scripts/report-qc.mjs",
    "dev": "npm run research:generate -- vpec-2455 --check && npm run report:materialize && node ./node_modules/next/dist/bin/next dev",
    "build": "npm run research:check && npm run report:materialize && node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "preview": "npm run report:materialize && node ./scripts/run-cloudflare.mjs preview",
    "deploy": "node ./scripts/research-publish.mjs vpec-2455 --remote",
    "cf-typegen": "node ./node_modules/wrangler/bin/wrangler.js types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:local:migrate": "node ./node_modules/wrangler/bin/wrangler.js d1 migrations apply research-report-db --local",
    "db:remote:migrate": "node ./node_modules/wrangler/bin/wrangler.js d1 migrations apply research-report-db --remote",
    "db:local:seed": "npm run research:import -- vpec-2455 --local",
    "db:remote:seed": "npm run research:import -- vpec-2455 --remote"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.3.0",
    "drizzle-orm": "^0.45.2",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "puppeteer-core": "25.9.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.0.0"
  }
}
