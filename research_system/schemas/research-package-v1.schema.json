        "valueText",
        "evidenceClass",
        "sourceIds"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "asOfDate": {
          "type": "string",
          "format": "date"
        },
        "metric": {
          "type": "string"
        },
        "status": {
          "enum": [
            "green",
            "yellow",
            "red"
          ]
        },
        "valueText": {
