          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "sortOrder",
        "payloadRefs",
        "showSources"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "summary",
            "kpi-grid",
            "financial-table",
            "bar-chart",
            "line-chart",
            "bridge",
            "scenario-table",
            "capacity",
            "signals",
            "catalysts-risks",
            "sources",
            "conclusion"
          ]
        },
        "title": {
          "type": "string"
        },
        "sortOrder": {
          "type": "integer",
          "minimum": 1
        },
        "payloadRefs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "showSources": {
          "type": "boolean"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "evidenceClass",
        "provider",
        "title",
        "accessedDate",
        "coveredPeriods",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "evidenceClass": {
          "enum": [
            "official",
            "third_party_fact",
            "market_consensus",
            "research_inference"
          ]
        },
