{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-report.local/schemas/research-package-v1.schema.json",
  "title": "Research Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageVersion",
    "asOfDate",
    "company",
    "report",
    "thesis",
    "dashboard",
    "actuals",
    "monthlyRevenue",
    "segments",
    "forecasts",
    "capacity",
    "catalysts",
    "risks",
    "signalRules",
    "signalSnapshots",
    "sections",
    "sources",
    "claims"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "packageVersion": {
      "type": "string",
      "minLength": 1
    },
    "asOfDate": {
      "type": "string",
      "format": "date"
    },
    "company": {
      "$ref": "#/$defs/company"
    },
    "report": {
      "$ref": "#/$defs/report"
    },
    "thesis": {
      "$ref": "#/$defs/thesis"
    },
    "dashboard": {
      "$ref": "#/$defs/dashboard"
    },
    "actuals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actual"
      }
    },
    "monthlyRevenue": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/monthlyRevenue"
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/segment"
      }
    },
    "forecasts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/forecast"
      }
    },
    "capacity": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capacity"
      }
    },
    "catalysts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/catalyst"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/risk"
      }
    },
    "signalRules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/signalRule"
      }
    },
    "signalSnapshots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/signalSnapshot"
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    }
  },
  "$defs": {
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currentView", "verificationChain", "conclusion", "forecastScenario", "headlineForecastYears", "focusMetric", "monthlyRevenue", "cagrCards", "estimateNote"],
      "properties": {
        "currentView": { "type": "string" },
        "verificationChain": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "conclusion": { "type": "string" },
        "forecastScenario": { "type": "string" },
        "headlineForecastYears": { "type": "array", "items": { "type": "integer" }, "minItems": 1, "uniqueItems": true },
        "focusMetric": {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "label"],
          "properties": {
            "field": { "enum": ["optoShare"] },
            "label": { "type": "string" }
          }
        },
        "monthlyRevenue": {
          "type": "object",
          "additionalProperties": false,
          "required": ["focusYear", "cumulativeThroughMonth", "unitDivisor", "unitLabel"],
          "properties": {
            "focusYear": { "type": "integer" },
            "cumulativeThroughMonth": { "type": "integer", "minimum": 1, "maximum": 12 },
            "unitDivisor": { "type": "number", "minimum": 0.000001 },
            "unitLabel": { "type": "string" }
          }
        },
        "cagrCards": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "label", "baseYear", "targetYear", "baseValue", "years"],
            "properties": {
              "field": { "enum": ["revenue", "eps"] },
              "label": { "type": "string" },
              "baseYear": { "type": "integer" },
              "targetYear": { "type": "integer" },
              "baseValue": { "type": "number", "minimum": 0.000001 },
              "years": { "type": "number", "minimum": 0.000001 }
            }
          }
        },
        "estimateNote": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "evidenceClass": {
          "enum": [
            "official",
            "third_party_fact",
            "market_consensus",
            "research_inference"
          ]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "claimIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ticker",
        "market",
        "name",
        "slug",
        "currency"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "ticker": {
          "type": "string"
        },
        "market": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "sector": {
          "type": "string"
        },
        "industry": {
          "type": "string"
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "description": {
          "type": "string"
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "slug",
        "status",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "thesis": {
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "review",
            "published",
            "archived"
          ]
        },
        "version": {
          "type": "string"
        },
        "publishedAt": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "thesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "coreChain",
        "claimIds"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "coreChain": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "claimIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "actual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "period",
        "fiscalYear",
        "currency",
        "scale",
        "evidenceClass",
        "sourceIds"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "period": {
          "type": "string"
        },
        "fiscalYear": {
          "type": "integer"
        },
        "quarter": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 4
        },
        "revenue": {
          "type": [
            "number",
            "null"
          ]
        },
        "grossProfit": {
          "type": [
            "number",
            "null"
          ]
        },
        "grossMargin": {
          "type": [
            "number",
            "null"
          ]
        },
        "operatingIncome": {
          "type": [
            "number",
            "null"
          ]
        },
        "operatingMargin": {
          "type": [
            "number",
            "null"
          ]
        },
        "netIncome": {
          "type": [
            "number",
            "null"
          ]
        },
        "netMargin": {
          "type": [
            "number",
            "null"
          ]
        },
        "eps": {
          "type": [
            "number",
            "null"
          ]
        },
        "currency": {
          "type": "string"
        },
        "scale": {
          "enum": [
            "unit",
            "thousand",
            "million",
            "billion"
          ]
        },
        "evidenceClass": {
          "enum": [
            "official",
            "third_party_fact",
            "market_consensus",
            "research_inference"
          ]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "claimIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "monthlyRevenue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "year",
        "month",
        "revenue",
        "currency",
        "scale",
        "evidenceClass",
        "sourceIds"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "year": {
          "type": "integer"
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "revenue": {
          "type": "number"
        },
        "mom": {
          "type": [
            "number",
            "null"
          ]
        },
        "yoy": {
          "type": [
            "number",
            "null"
          ]
        },
        "currency": {
          "type": "string"
        },
        "scale": {
          "enum": [
            "unit",
            "thousand",
            "million",
            "billion"
          ]
        },
        "evidenceClass": {
          "enum": [
            "official",
            "third_party_fact",
            "market_consensus",
            "research_inference"
          ]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "claimIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "period",
        "segment",
        "isEstimate",
        "currency",
        "scale",
        "evidenceClass",
        "sourceIds",
        "claimIds"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "period": {
          "type": "string"
        },
        "segment": {
          "type": "string"
        },
        "revenue": {
          "type": [
            "number",
            "null"
          ]
        },
        "share": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "isEstimate": {
          "type": "boolean"
        },
        "currency": {
          "type": "string"
        },
        "scale": {
          "enum": [
            "unit",
            "thousand",
            "million",
            "billion"
          ]
        },
        "evidenceClass": {
          "enum": [
            "official",
            "third_party_fact",
            "market_consensus",
            "research_inference"
          ]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "claimIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "forecast": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fiscalYear",
        "scenario",
        "currency",
        "scale",
        "evidenceClass",
        "sourceIds",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "fiscalYear": {
          "type": "integer"
        },
        "scenario": {
          "type": "string"
        },
        "revenue": {
          "type": [
            "number",
            "null"
          ]
        },
        "grossMargin": {
          "type": [
            "number",
            "null"
          ]
        },
        "netIncome": {
          "type": [
            "number",
            "null"
          ]
        },
        "eps": {
          "type": [
            "number",
            "null"
          ]
        },
        "optoShare": {
          "type": [
            "number",
            "null"
          ]
        },
        "currency": {
          "type": "string"
        },
        "scale": {
          "enum": [
            "unit",
            "thousand",
            "million",
            "billion"
          ]
        },
        "notes": {
          "type": "string"
        },
        "evidenceClass": {
          "enum": [
            "official",
            "third_party_fact",
            "market_consensus",
            "research_inference"
          ]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "claimIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "equipment",
        "status",
        "evidenceClass",
        "sourceIds"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "eventDate": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "equipment": {
          "type": "string"
        },
        "technology": {
          "type": "string"
        },
        "deltaUnits": {
          "type": [
            "integer",
            "null"
          ]
        },
        "baseUnits": {
          "type": [
            "integer",
            "null"
          ]
        },
        "expectedOnlineDate": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "evidenceClass": {
          "enum": [
            "official",
            "third_party_fact",
            "market_consensus",
            "research_inference"
          ]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "claimIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "catalyst": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "impact",
        "status",
        "evidenceClass",
        "sourceIds"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "impact": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "evidenceClass": {
          "enum": [
            "official",
            "third_party_fact",
            "market_consensus",
            "research_inference"
          ]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "claimIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "impact",
        "probability",
        "status",
