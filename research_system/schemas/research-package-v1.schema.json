          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "attachment": {
          "type": "string"
        },
        "publishedDate": {
          "type": "string",
          "format": "date"
        },
        "accessedDate": {
          "type": "string",
          "format": "date"
        },
        "coveredPeriods": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "evidenceClass",
        "sourceIds",
        "inputClaimIds",
        "method",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "evidenceClass": {
          "enum": [
            "official",
            "third_party_fact",
            "market_consensus",
            "research_inference"
          ]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "inputClaimIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "method": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
