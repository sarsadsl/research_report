        "sourceIds"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "impact": {
          "type": "string"
        },
        "probability": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "evidenceClass": {
          "enum": [
            "official",
            "third_party_fact",
            "market_consensus",
            "research_inference"
          ]
        },
        "sourceIds": {
          "type": "array",
