        },
        "claimIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "signalRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "metric",
        "greenCondition",
        "yellowCondition",
        "redCondition",
        "weight",
        "evidenceClass",
        "sourceIds"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "metric": {
          "type": "string"
        },
        "greenCondition": {
          "type": "string"
        },
        "yellowCondition": {
          "type": "string"
        },
        "redCondition": {
          "type": "string"
        },
        "weight": {
          "type": "number"
        },
        "evidenceClass": {
          "enum": [
            "official",
